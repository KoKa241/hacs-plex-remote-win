{
  "name": "Plex PC Remote keyboard",
  "idmatcher": "Keyboard.*",
  "mapping": {
    "Up": "up",
    "Down": "down",
    "Left": "left",
    "Right": "right",
    "Return|Enter": "enter",
    "Esc|Escape|Backspace": "back",
    "F13": "play_pause",
    "F14": "play",
    "F15": "pause",
    "F16": "stop",
    "F17": "seek_backward",
    "F18": "seek_forward",
    "F19": "skip_previous",
    "F20": "skip_next",
    "F21": "home",
    "F22": "decrease_volume",
    "F23": "increase_volume",
    "F24": "mpv:cycle mute",
    "Ctrl\\+F13": "toggle_subtitles",
    "Ctrl\\+F14": "cycle_audio",
    "Ctrl\\+F15": "toggle_fullscreen",
    "Ctrl\\+F16": "info",
    "Space": "play_pause",
    "(?:Shift\\+)?([A-Z0-9.])": "%1"
  }
}
